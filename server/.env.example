# Copia este archivo a ".env" (en esta misma carpeta) y rellena tus valores reales.
# NUNCA subas el archivo ".env" a git (ya está en .gitignore).

# Client ID y Secret que te da TradeStation al aprobar tu acceso a la API.
TS_CLIENT_ID=
TS_CLIENT_SECRET=

# Debe coincidir EXACTO con el redirect URI registrado en tu API key de TradeStation.
TS_REDIRECT_URI=http://localhost:3000/auth/callback

# "sim" (recomendado, cuenta simulada) o "live" (cuenta real). Empieza en sim.
TS_ENV=sim

# Puerto donde corre este servidor local.
PORT=3000

# API key gratuita de Alpha Vantage (fundamentales, earnings y noticias).
# Se obtiene al instante, sin tarjeta, en https://www.alphavantage.co/support/#api-key
# El tier gratuito permite ~25 requests/día — el servidor cachea las respuestas
# para no agotarlo (1h fundamentales/earnings, 15min noticias).
ALPHAVANTAGE_API_KEY=
